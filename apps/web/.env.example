DATABASE_URL=postgres://photodost:devpass@localhost:5432/photodost
REDIS_URL=redis://localhost:6380

# ---- Object storage ----
# Local: MinIO. Production: Backblaze B2 fronted by Cloudflare — B2 is ~2.2×
# cheaper per GB than R2 ($0.00695 vs $0.015/GB-month) and the Bandwidth
# Alliance makes egress through Cloudflare free, which is what a photo-delivery
# product actually needs. Storage is the dominant COGS here, so this matters.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photodost-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true for MinIO; false for B2 (virtual-hosted endpoints).
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/photodost-dev

# Production (Backblaze B2) looks like this — note the region appears in both
# the endpoint and S3_REGION, and the keys are a B2 *application key* pair:
#   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   S3_REGION=us-west-004
#   S3_BUCKET=photodost-prod
#   S3_ACCESS_KEY=<keyID>
#   S3_SECRET_KEY=<applicationKey>
#   S3_FORCE_PATH_STYLE=false
#   S3_PUBLIC_URL=https://cdn.photodost.app   # Cloudflare-proxied, NOT the raw
#                                             # B2 URL — going direct bills egress

ML_SERVICE_URL=http://localhost:8000

APP_URL=http://localhost:3030
NODE_ENV=development

# ---- Auth (Better Auth) ----
# Generate once:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3030
# Google OAuth is optional locally — magic links work without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (magic links) ----
# Local: Mailpit. Open http://localhost:8025 to read the sign-in emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Photo Dost <no-reply@photodost.app>

# ---- Billing (Cashfree Subscriptions) ----
# Leave false to run in Beta mode: usage is tracked but never capped, so the
# whole product is testable without a payment gateway. Set true only once the
# credentials below are filled in — with billing on but Cashfree unconfigured
# there is no way for a workspace to raise its own quotas.
# Full runbook: docs/BILLING.md
BILLING_ENABLED=false

# Dashboard → Developers → API Keys. Sandbox secrets contain `_test_`.
# The secret key ALSO signs webhooks, so there is no separate webhook secret.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Selects the API host — sandbox.cashfree.com/pg vs api.cashfree.com/pg.
# Cashfree does not infer this from the key, so it must be set explicitly; a
# key/mode mismatch is rejected at startup rather than failing as a 401.
CASHFREE_MODE=sandbox

# No plan IDs here on purpose: they're merchant-supplied and derived from the
# PLANS catalog by `cashfreePlanId()`. Create them with
# `pnpm billing:create-plans` — there is nothing to paste back.
