# ML service environment - mostly inherited from docker-compose.yml.
# Useful when running `uvicorn app.main:app --reload` outside Docker.
ML_HOST=0.0.0.0
ML_PORT=8000

DATABASE_URL=postgres://photodost:devpass@localhost:5432/photodost

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photodost-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Auth ----
# Shared secret the web app and worker send as `Authorization: Bearer <token>`.
# /healthz stays open so platform health probes work; /embed* require this.
#
# Leave blank locally and the service starts with a loud warning. Set
# ML_ENV=production and the service REFUSES TO START without a token — this
# service has no other protection and inference is its whole cost centre.
#   openssl rand -hex 32
ML_ENV=development
ML_SERVICE_TOKEN=
