DATABASE_URL=postgres://photodost:devpass@localhost:5432/photodost
REDIS_URL=redis://localhost:6380

# ---- Object storage ----
# Local: MinIO. Production: Backblaze B2 (S3_FORCE_PATH_STYLE=false) — see
# apps/web/.env.example for the full production block.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photodost-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

ML_SERVICE_URL=http://localhost:8000

NODE_ENV=development
LOG_LEVEL=info

# ---- Email (retention warning emails) ----
# Local: Mailpit (http://localhost:8025). The worker sends the two "your photos
# will be deleted" emails, so it needs SMTP independently of the web app.
# If mail is broken the retention sweep will NOT purge — that's deliberate.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Photo Dost <no-reply@photodost.app>

# Used to build the "choose a plan" links in those emails.
APP_URL=http://localhost:3030

# ---- Billing (Cashfree) ----
# The worker reads its OWN env — it never sees apps/web/.env. These must be set
# here (and on the deployed worker) or two things silently stop working:
#   1. the deferred-cancellation sweep (Cashfree has no cancel-at-cycle-end)
#   2. dropping lapsed workspaces to the free tier
# Full runbook: docs/BILLING.md
BILLING_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox
