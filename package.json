{
  "name": "photo-dost",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @photodost/db generate",
    "db:push": "pnpm --filter @photodost/db push",
    "db:studio": "pnpm --filter @photodost/db studio",
    "billing:create-plans": "pnpm --filter @photodost/web billing:create-plans",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --remove-orphans",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down --remove-orphans",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v --remove-orphans",
    "db:migrate": "pnpm --filter @photodost/db migrate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
