# Root .env.example - shared values across apps.
# Each app also has its own .env.example with the keys it actually reads.
# Copy this to .env and adjust as needed for local dev.

# ---- Database ----
DATABASE_URL=postgres://photodost:devpass@localhost:5432/photodost

# ---- Redis (for BullMQ) ----
REDIS_URL=redis://localhost:6380

# ---- Object storage (local MinIO; Backblaze B2 + Cloudflare CDN in prod) ----
# B2 is ~2.2× cheaper per GB than R2 and egress through Cloudflare is free via
# the Bandwidth Alliance. See apps/web/.env.example for the production block.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photodost-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true for MinIO; false for B2 (virtual-hosted endpoints).
S3_FORCE_PATH_STYLE=true
# Public base URL the BROWSER uses to fetch photos (no auth, no presign).
# Locally this is the same host as S3_ENDPOINT. In prod this is the CDN origin
# (e.g. https://cdn.photodost.com).
S3_PUBLIC_URL=http://localhost:9000/photodost-dev

# Face matching
ML_SERVICE_URL=http://localhost:8000
# Must match ML_SERVICE_TOKEN on the ML service. Blank locally.
ML_SERVICE_TOKEN=


# ---- App ----
APP_URL=http://localhost:3030
NODE_ENV=development

# ---- Auth (Better Auth) — read by apps/web ----
# Generate once:  openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3030
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Billing (Cashfree) — read by the WORKER ----
# The worker needs these only for the deferred-cancellation sweep, which issues
# the real CANCEL once a paid period lapses (Cashfree has no cancel-at-cycle-end).
# It reads apps/worker/.env then this file, so it never sees apps/web/.env —
# hence the duplication. With these unset the sweep logs and does nothing.
# Full runbook: docs/BILLING.md
BILLING_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox

# ---- Email (magic links via Mailpit locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Photo Dost <no-reply@photodost.app>
